# Copy this file to `.env.local` and fill in only the keys you want the server to use.
# Keys entered by users in Settings take precedence per request and are
# never stored on the server. Never commit real keys to git.

# Server-side (owner deployment) provider keys — optional.
# If set, users can chat without entering their own key.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_API_KEY=
# GROQ_API_KEY is the shared key: set it and visitors get full AI
# answers with no key of their own. Groq's free tier needs no card
# (30 req/min, 1,000 req/day); past the limit it returns 429, never
# a charge. Nothing is billed without adding a payment method.
GROQ_API_KEY=

# Default models (optional). A model chosen in Settings takes precedence
# over these; these take precedence over the built-in defaults
# (Gemini gemini-3.8-flash, OpenAI gpt-6-luna, Claude claude-sonnet-5-5,
# Hugging Face Qwen/Qwen3.8-27B, Groq openai/gpt-oss-120b).
# For Gemini, if the configured model returns 404 (model not found),
# the proxy retries once with gemini-3.6-flash, then
# gemini-3.5-flash-lite. Quota/429 errors are never retried against a
# fallback model. Chat temperature is fixed at 0.3 in the proxy.
FOODLENS_GEMINI_MODEL=
FOODLENS_OPENAI_MODEL=
FOODLENS_ANTHROPIC_MODEL=
FOODLENS_HF_MODEL=
FOODLENS_GROQ_MODEL=

# Optional web search (server-side). If neither is set, the search
# endpoint returns 503 and the chat proxy relies on provider-native
# search (Gemini/OpenAI) or answers without claiming a search happened.
# Search is OFF by default in the UI.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Rate limiting / proxy trust (Batch 6). The rate limiter uses
# x-forwarded-for ONLY when TRUST_PROXY=true (a known proxy in front of
# this deployment sets it truthfully). By default ("direct" key) all
# clients share one 30/min bucket per scope: no client can spoof a fresh
# bucket, but one client can exhaust the shared bucket. Set TRUST_PROXY
# only behind a proxy you control.
TRUST_PROXY=false

# Disable user-supplied OpenAI-compatible base URLs on hosted
# deployments (Batch 6). Default (unset or anything but "false") keeps
# current local behaviour; "false" makes chat/models return a friendly
# error for the compatible provider instead of fetching a user URL.
ALLOW_CUSTOM_BASE_URL=true

# Test-only mock upstreams (Step B) — dev-only, localhost-only, ignored
# in production. Set ONLY when running the local mock servers in
# scripts/mock-gemini.mjs and scripts/mock-off.mjs, and only to a
# localhost URL (localhost, 127.0.0.1 or ::1). In production builds
# (NODE_ENV=production) these are ignored entirely and the real
# Google / Open Food Facts endpoints are used. A non-localhost value
# in non-production makes the route return 400 instead of fetching it.
# Never set these on a hosted deployment.
# FOODLENS_GEMINI_BASE_URL=http://127.0.0.1:4101
# FOODLENS_OFF_BASE_URL=http://127.0.0.1:4102
